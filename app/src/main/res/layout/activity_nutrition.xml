<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- BOTÓN VOLVER -->
        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="#6C63FF"
            android:tint="#FFFFFF"
            android:padding="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- MENSAJE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Si quieres llegar a tus objetivos de manera controlada, debes alinear tu alimentación, entrenamiento y descanso."
            android:textColor="#4B5563"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="16dp"/>

        <!-- OBJETIVO -->
        <TextView
            android:id="@+id/txtObjetivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Objetivo:"
            android:textColor="#111827"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <!-- CALORÍAS -->
        <TextView
            android:id="@+id/txtCalorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calorías:"
            android:textColor="#6C63FF"
            android:textSize="16sp"
            android:paddingBottom="16dp"/>

        <!-- DESAYUNO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Desayuno"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/btnDesayuno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completar"
                android:backgroundTint="#6C63FF"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtDesayuno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#1F2937"
            android:textSize="14sp"
            android:lineSpacingExtra="5dp"
            android:background="@drawable/options"
            android:padding="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"/>

        <!-- ALMUERZO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Almuerzo"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/btnAlmuerzo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completar"
                android:backgroundTint="#6C63FF"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtAlmuerzo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#1F2937"
            android:textSize="14sp"
            android:lineSpacingExtra="5dp"
            android:background="@drawable/options"
            android:padding="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"/>

        <!-- CENA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Cena"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/btnCena"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completar"
                android:backgroundTint="#6C63FF"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtCena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#1F2937"
            android:textSize="14sp"
            android:lineSpacingExtra="5dp"
            android:background="@drawable/options"
            android:padding="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"/>

        <!-- PROGRESO -->
        <TextView
            android:id="@+id/txtProgreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Progreso del día: 0%"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            android:background="#22C55E"/>

    </LinearLayout>
</ScrollView>