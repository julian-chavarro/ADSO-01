<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutSetRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/set_row_background">

    <TextView
        android:id="@+id/tvSetNumber"
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        android:text="1"
        android:textSize="16sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvTargetReps"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="12"
        android:textSize="16sp"
        android:gravity="center" />

    <EditText
        android:id="@+id/etWeight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/edit_text_background"
        android:gravity="center"
        android:hint="40"
        android:inputType="numberDecimal"
        android:padding="8dp" />

    <Button
        android:id="@+id/btnCompleteSet"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="Completar"
        android:textAllCaps="false"
        style="?android:attr/borderlessButtonStyle"
        android:background="@drawable/btn_complete_background" />

</LinearLayout>