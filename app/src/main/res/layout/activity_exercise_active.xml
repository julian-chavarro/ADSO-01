<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/colorSurface">

    <!-- Encabezado con Botón Atrás -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnBackToList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Lista"
            android:textAllCaps="false"
            android:backgroundTint="@android:color/white"
            android:textColor="?attr/colorOnSurface"
            style="?android:attr/borderlessButtonStyle" />

        <TextView
            android:id="@+id/dayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Día · Pecho"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/exerciseCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Ejercicio 1 de 5"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </RelativeLayout>

    <ProgressBar
        android:id="@+id/exerciseProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progress="40"
        android:progressTint="?attr/colorPrimary"
        android:layout_marginBottom="16dp"/>

    <!-- Información del Ejercicio -->
    <TextView
        android:id="@+id/exerciseName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Press de banca"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/muscles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pectoral, Tríceps, Deltoides anterior"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/videoButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="▶ Video de técnica"
        android:textAllCaps="false"
        android:gravity="center"
        android:layout_marginVertical="8dp"
        android:backgroundTint="?attr/colorPrimary"
        android:textColor="@android:color/white"
        android:textStyle="bold"/>

    <!-- Cabecera de Tabla -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:layout_marginTop="12dp">
        <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="#" android:textStyle="bold" android:gravity="center" android:textColor="?attr/colorOnSurfaceVariant"/>
        <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Reps" android:textStyle="bold" android:gravity="center" android:textColor="?attr/colorOnSurfaceVariant"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Peso (kg)" android:textStyle="bold" android:gravity="center" android:textColor="?attr/colorOnSurfaceVariant"/>
        <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="Estado" android:textStyle="bold" android:gravity="center" android:textColor="?attr/colorOnSurfaceVariant"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSets"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Indicador de ejercicio completado -->
    <TextView
        android:id="@+id/tvExerciseCompleted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/exercise_completed_indicator"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/green_800"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone" />

    <!-- Navegación entre ejercicios -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnPreviousExercise"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="@string/exercise_previous"
            android:textAllCaps="false"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="@android:color/white"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnNextExercise"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="@string/exercise_next"
            android:textAllCaps="false"
            android:layout_marginStart="4dp"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="@android:color/white"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
