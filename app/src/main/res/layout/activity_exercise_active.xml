<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F9F9F7">

    <!-- Encabezado con Botón Atrás -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnBackToList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Lista"
            android:textAllCaps="false"
            android:backgroundTint="@android:color/white"
            android:textColor="@android:color/black"
            style="?android:attr/borderlessButtonStyle" />

        <TextView
            android:id="@+id/dayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Día 2 · Lunes"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#3F51B5" />

        <TextView
            android:id="@+id/exerciseCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Ejercicio 2 de 5"
            android:textColor="#666666" />
    </RelativeLayout>

    <ProgressBar
        android:id="@+id/exerciseProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progress="40"
        android:progressTint="#3F51B5"
        android:layout_marginBottom="16dp"/>

    <!-- Información del Ejercicio -->
    <TextView
        android:id="@+id/exerciseName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Press de banca"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/black" />

    <TextView
        android:id="@+id/muscles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pectoral, Tríceps, Deltoides anterior"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/videoButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="▶ Video de técnica"
        android:textAllCaps="false"
        android:backgroundTint="@android:color/white"
        android:textColor="#666666"
        style="?android:attr/borderlessButtonStyle"/>

    <!-- Cabecera de Tabla -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:layout_marginTop="12dp">
        <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="#" android:textStyle="bold" android:gravity="center"/>
        <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Reps" android:textStyle="bold" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Peso (kg)" android:textStyle="bold" android:gravity="center"/>
        <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="Estado" android:textStyle="bold" android:gravity="center"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSets"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Sección Descanso -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_white_background"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descanso recomendado: 90 seg"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01:30"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/startButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Iniciar ▶"
            android:textAllCaps="false"
            android:backgroundTint="@android:color/white"
            android:textColor="@android:color/black" />
    </LinearLayout>

    <Button
        android:id="@+id/nextExerciseButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Siguiente ejercicio →"
        android:textAllCaps="false"
        android:layout_marginTop="12dp"
        android:backgroundTint="#3F51B5"
        android:textColor="@android:color/white"
        android:textStyle="bold"/>

</LinearLayout>
