<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.adso_01"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:name=".AdsoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ADSO01">

        <!-- Pantalla de Inicio -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Gestión de Autenticación -->
        <activity android:name=".ui.LoginActivity" />
        <activity android:name=".ui.RegisterActivity" />
        <activity android:name=".ui.ForgotPasswordActivity" />

        <!-- Dashboard y Perfil -->
        <activity android:name=".ui.LobbyActivity" />
        <activity android:name=".ui.ObjetivoActivity" />
        <activity android:name=".ui.NutritionActivity" />

        <!-- Módulo de Entrenamiento (Workout) -->
        <activity android:name=".ui.RoutineSelectionActivity" />
        <activity android:name=".ui.WarmupActivity" />
        <activity android:name=".ui.ExerciseActiveActivity" />

        <!-- Otros Módulos -->
        <activity android:name=".ui.ChatActivity" />
        <activity android:name=".ui.ProgressActivity" />

        <!-- Resumen post-entreno -->
        <activity android:name=".ui.WorkoutSummaryActivity" />

    </application>

</manifest>